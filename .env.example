# Copy to .env (which is git-ignored) or run `jobscout init`.
# NOTHING in .env is ever committed, and none of these paths may point inside
# the repo — jobscout refuses to start if they do.

# The folder holding the applications you have already written.
JOBSCOUT_APPLICATIONS_DIR="/absolute/path/to/your/job applications"

# Where jobscout keeps its profile, employer registry, history and reports.
JOBSCOUT_DATA_DIR=~/.jobscout

# "cli" bills the Claude Code account you are logged into and gets hosted web
# search; "anthropic" uses ANTHROPIC_API_KEY; "mock" runs offline for free.
#
# A Claude subscription and an API account are separate balances. If a run
# stops with "usage limit reached" under "cli", switch to "anthropic" and
# set a key from console.anthropic.com — the same agents, the same hosted
# web search and web fetch, billed per token instead.
JOBSCOUT_BACKEND=cli
# ANTHROPIC_API_KEY=sk-ant-...
JOBSCOUT_MODEL_CHEAP=claude-haiku-4-5
JOBSCOUT_MODEL_STRONG=claude-opus-5

# --- the hard filters ---
# YOUR location, and nobody else's. Leave both blank and remote-only roles are
# all that can qualify. State codes are two letters; cities are whatever the
# postings call them.
JOBSCOUT_ALLOWED_STATES=
JOBSCOUT_ALLOWED_CITIES=
JOBSCOUT_ALLOW_REMOTE=true
JOBSCOUT_ALLOW_HYBRID=false
JOBSCOUT_MAX_AGE_DAYS=30

# --- per-run budget ---
# Leave these commented out unless you mean to override the defaults: a value
# set here wins forever, and freezes the tool at whatever the default was when
# you wrote it.
# JOBSCOUT_COMPANY_TARGET=120
# JOBSCOUT_MAX_RESOLVE_PER_RUN=20
# JOBSCOUT_MAX_SCANS_PER_RUN=8
# JOBSCOUT_MAX_VERIFY_PER_RUN=20
# JOBSCOUT_MAX_RESULTS=10
# JOBSCOUT_MAX_WORKERS=6

# --- ranking: fit vs. your realistic odds vs. freshness ---
JOBSCOUT_WEIGHT_FIT=0.45
JOBSCOUT_WEIGHT_LIKELIHOOD=0.30
JOBSCOUT_WEIGHT_RECENCY=0.25
JOBSCOUT_RECENCY_HALFLIFE_DAYS=14

# --- the local web app (`jobscout serve`) ---
JOBSCOUT_PORT=8765

JOBSCOUT_EXCLUDE_COMPANIES=
