# Copy to .env (which is git-ignored) or run `jobscout init`.
# NOTHING in .env is ever committed, and none of these paths may point inside
# the repo — jobscout refuses to start if they do.

# The folder holding the applications you have already written.
JOBSCOUT_APPLICATIONS_DIR="/absolute/path/to/your/job applications"

# Where jobscout keeps its profile, employer registry, history and reports.
JOBSCOUT_DATA_DIR=~/.jobscout

# "cli" bills the Claude Code account you are logged into and gets hosted web
# search; "anthropic" uses ANTHROPIC_API_KEY; "mock" runs offline for free.
JOBSCOUT_BACKEND=cli
JOBSCOUT_MODEL_CHEAP=claude-haiku-4-5
JOBSCOUT_MODEL_STRONG=claude-opus-5

# --- the hard filters ---
JOBSCOUT_ALLOWED_STATES=NM
JOBSCOUT_ALLOWED_CITIES=Albuquerque,Santa Fe,Los Alamos,Rio Rancho,Las Cruces
JOBSCOUT_ALLOW_REMOTE=true
JOBSCOUT_ALLOW_HYBRID=false
JOBSCOUT_MAX_AGE_DAYS=30

# --- per-run budget (each is a billed model call) ---
JOBSCOUT_COMPANY_TARGET=30
JOBSCOUT_MAX_RESOLVE_PER_RUN=10
JOBSCOUT_MAX_SCANS_PER_RUN=12
JOBSCOUT_MAX_VERIFY_PER_RUN=20
JOBSCOUT_MAX_RESULTS=10
JOBSCOUT_MAX_WORKERS=4

JOBSCOUT_EXCLUDE_COMPANIES=
